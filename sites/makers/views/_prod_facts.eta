<%/* include('_prod_facts', {g, x}) the product page's metrics block (product widget slot: in a shadow root, or with the revenue from page JSON) */%><% const g = it.g; const x = it.x; const val = (k, t) => (g.revJs ? g.rev(`${x.slug}-${k}`, t) : g.h(t)); %><dl class="prod-facts">
    <div><dt>Monthly revenue</dt><dd><%~ val('mrr', x.mrr ? g.K.money(x.mrr) : x.mrr === 0 ? '$0' : 'Not shared') %></dd></div>
    <% if (g.rank && x.mrr) { %><div><dt>Revenue rank</dt><dd><%~ val('rank', `#${g.rank}`) %></dd></div><% } %>
    <div><dt>Founder</dt><dd><% if (x.founder_account) { %><a href="/<%= x.founder_handle %>"><%= x.founder_name %></a><% } else { %><%= x.founder_name %><% } %></dd></div>
  </dl>