<% layout('layout') %>
<% const qs = (o) => { const sp = new URLSearchParams(); const v = { sort: it.sort, q: it.q, topic: it.topic, ...o }; for (const [k, x] of Object.entries(v)) if (x && !(k === 'sort' && x === 'revenue')) sp.set(k, x); const s = sp.toString(); return '/products' + (s ? '?' + s : ''); }; %>
<section class="hero"><h1>Products</h1><p class="muted"><%= it.totals.n %> products by members of the community &middot; <%= it.totals.paying %> with paying customers &middot; <% if (it.revJs) { %><%~ it.rev('total', it.K.money(it.totals.mrr)) %><% } else { %><%= it.K.money(it.totals.mrr) %><% } %> combined monthly revenue</p></section>
<div class="cols cols-2">
  <nav class="col-left" aria-label="Categories">
    <h2 class="side-h">Categories</h2>
    <a class="side-link<%= !it.topic ? ' on' : '' %>" href="<%= qs({ topic: null, page: null }) %>">All</a>
    <% for (const t of it.topics) { %><a class="side-link<%= it.topic === t.topic ? ' on' : '' %>" href="<%= qs({ topic: t.topic }) %>"><%= it.K.topicLabel(t.topic) %><span class="side-tag"><%= t.n %></span></a><% } %>
  </nav>
  <section class="col-main">
    <div class="pills">
      <a class="pill<%= it.sort === 'revenue' ? ' on' : '' %>" href="<%= qs({ sort: 'revenue' }) %>">Highest revenue</a><a class="pill<%= it.sort === 'newest' ? ' on' : '' %>" href="<%= qs({ sort: 'newest' }) %>">Newest</a><a class="pill<%= it.sort === 'name' ? ' on' : '' %>" href="<%= qs({ sort: 'name' }) %>">A&ndash;Z</a>
      <form method="get" action="/products" class="inline pills-new"><% if (it.sort !== 'revenue') { %><input type="hidden" name="sort" value="<%= it.sort %>"><% } %><% if (it.topic) { %><input type="hidden" name="topic" value="<%= it.topic %>"><% } %><input type="search" name="q" value="<%= it.q %>" placeholder="Filter products" aria-label="Filter products"></form>
    </div>
    <% if (!it.rows.length) { %><div class="card card-pad empty">No products match.</div><% } %>
    <div class="prod-list card">
    <% it.rows.forEach((x, i) => { %>
      <a class="prod-row" href="/product/<%= x.slug %>">
        <span class="prod-rank muted"><%= it.sort === 'revenue' ? it.offset + i + 1 : '' %></span>
        <span class="prod-logo" style="--p:<%= it.colorFor(x.slug) %>" aria-hidden="true"><%= x.name.slice(0, 1) %></span>
        <span class="prod-main"><strong><%= x.name %></strong><span class="muted small"><%= x.tagline %></span><span class="small">by <%= x.founder_name %> &middot; <%= it.K.topicLabel(x.topic) %> &middot; launched <%= it.monthYear(x.launched_at) %></span></span>
        <span class="prod-mrr"><% if (it.revJs) { %><%~ it.rev(`${x.slug}-row`, x.mrr ? `${it.K.money(x.mrr)}/month` : x.mrr === 0 ? 'Pre-revenue' : 'Not shared') %><% } else if (x.mrr) { %><strong><%= it.K.money(x.mrr) %></strong><span class="muted small">/month</span><% } else if (x.mrr === 0) { %><span class="muted small">Pre-revenue</span><% } else { %><span class="muted small">Not shared</span><% } %></span>
      </a>
    <% }) %>
    </div>
    <p class="pager"><% if (it.p.prev) { %><a href="<%= it.p.prev %>">&larr; Previous</a><% } %> <% if (it.p.next) { %><a href="<%= it.p.next %>">Next &rarr;</a><% } %></p>
  </section>
</div>
