<%/* include('_message', {g, m}) one private message (no surrounding whitespace: the thread page's list is byte-identical) */%><% const g = it.g; const m = it.m; %><li id="m<%= m.id %>" class="msg<%= g.user && m.sender_id === g.user.id ? ' mine' : '' %>"><p class="msg-meta"><b>u/<%= m.username %></b> &bull; <%~ g.when(m.created_at) %></p><div class="md"><%~ g.md(m.body) %></div></li>