<% layout('layout') %>
<div class="narrow">
  <a class="back-link" href="/inbox">&larr; Inbox</a>
  <h1 class="page-title"><%= it.t.subject || 'Conversation' %></h1>
  <p class="muted">With <% for (const [i, o] of it.others.entries()) { %><%= i ? ', ' : '' %><a href="/u/<%= o %>">u/<%= o %></a><% } %></p>
  <% if (it.older) { %><%~ it.older %><% } else { %><ol class="messages">
  <% for (const m of it.msgs) { %>
    <%~ include('_message', { g: it, m }) %>
  <% } %>
  </ol><% } %>
  <form method="post" action="/inbox/<%= it.t.id %>/reply" class="comment-form"><%~ it.csrfInput() %>
    <label for="reply-msg" class="sr-only">Reply</label>
    <textarea id="reply-msg" name="body" rows="4" placeholder="Write a reply"></textarea>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Send</button></div>
  </form>
</div>
