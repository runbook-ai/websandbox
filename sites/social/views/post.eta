<% layout('layout') %>
<% const S = it.S; const s = it.s; const sp = it.space; const url = S.postUrl(s); const live = !s.removed; let domain = null; if (s.url) { try { domain = new URL(s.url).hostname.replace(/^www\./, ''); } catch {} } %>
<div class="cr-cols">
<div class="cr-content">
  <a class="back-link" href="/c/<%= sp.name %>">&larr; c/<%= sp.name %></a>
  <article class="post-detail" id="t3_<%= s.id %>" post-id="<%= s.id %>">
    <div class="post-head">
      <a class="space-link" href="/c/<%= sp.name %>"><span class="space-icon" style="background:<%= sp.icon_color || '#0079d3' %>" aria-hidden="true"></span><b>c/<%= sp.name %></b></a>
      <span class="dot" aria-hidden="true">&bull;</span><%~ it.when(s.created_at) %>
      <div class="by">u/<a href="/u/<%= s.username %>" class="user-link" data-hovercard="<%= s.username %>"><%= s.username %></a></div>
    </div>
    <% if (s.removed) { %>
      <h1 class="post-title">[ Removed by moderator ]</h1>
      <p class="notice">Sorry, this post was removed by the moderators of c/<%= sp.name %>.</p>
    <% } else { %>
      <h1 class="post-title"><%= s.title %></h1>
      <% if (s.flair) { %><a class="flair" style="--flair:<%= s.flair_color %>" href="/c/<%= sp.name %>?flair=<%= s.flair_id %>"><%= s.flair %></a><% } %>
      <% if (s.visibility !== 'visible') { %><p class="notice notice-warn">This post is <%= s.visibility === 'trashed' ? 'removed' : 'deleted' %> and only visible to you<%= it.mod ? ' and the moderators' : '' %>.</p><% } %>
      <% if (domain) { %><a class="post-link" href="<%= s.url %>" rel="nofollow ugc noopener" target="_blank"><%= s.url %> <span aria-hidden="true">&#8599;</span></a><% } %>
      <% if (s.image_path) { %><figure class="post-image"><img src="<%= S.mediaUrl(s.image_path) %>" alt="<%= s.title %>"></figure><% } %>
      <% if (it.editing) { %>
        <form method="post" action="<%= url %>/edit" class="edit-form"><%~ it.csrfInput() %>
          <%~ include('_editor', { g: it, name: 'body', value: s.body, label: 'Post body', id: 'post-body-edit', rows: 10 }) %>
          <div class="form-actions"><a class="btn btn-ghost" href="<%= url %>">Cancel</a><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
      <% } else if (s.body) { %><div class="post-body md"><%~ it.md(s.body) %></div><% } %>
      <% if (s.edited_at) { %><p class="muted small">Edited <%~ it.when(s.edited_at) %></p><% } %>
    <% } %>
    <div class="post-actions">
      <% if (live) { %><%~ include('_vote', { g: it, thing: `t3_${s.id}`, score: s.net_score, mine: it.vote, size: 'row' }) %><% } %>
      <a class="act" href="#comments"><span class="ico ico-comment" aria-hidden="true"></span><%= S.compact(it.tree.count) %></a>
      <button type="button" class="act" data-share="<%= url %>"><span class="ico ico-share" aria-hidden="true"></span>Share</button>
      <form method="post" action="/save" class="inline save-form"><%~ it.csrfInput() %><input type="hidden" name="thing" value="t3_<%= s.id %>"><input type="hidden" name="saved" value="<%= it.saved ? 0 : 1 %>"><input type="hidden" name="next" value="<%= it.req.url %>">
        <button type="submit" class="act" aria-pressed="<%= it.saved %>"><span class="ico ico-save" aria-hidden="true"></span><%= it.saved ? 'Unsave' : 'Save' %></button></form>
      <% if (it.own || it.mod) { %>
      <details class="more-menu"><summary class="act" aria-label="More options">&middot;&middot;&middot;</summary>
        <div class="cr-menu" role="menu">
          <% if (it.own && !s.url && s.visibility === 'visible') { %><a role="menuitem" href="<%= url %>?edit=1">Edit post</a><% } %>
          <% if (it.own && s.visibility === 'visible') { %><form method="post" action="<%= url %>/delete" data-confirm="Delete this post? This can't be undone."><%~ it.csrfInput() %><button type="submit" role="menuitem">Delete</button></form><% } %>
          <% if (it.mod) { %>
            <% for (const [a, l] of [[s.sticky ? 'unpin' : 'pin', s.sticky ? 'Unpin post' : 'Pin post'], [s.locked ? 'unlock' : 'lock', s.locked ? 'Unlock comments' : 'Lock comments'], [s.visibility === 'visible' ? 'remove' : 'approve', s.visibility === 'visible' ? 'Remove as moderator' : 'Approve']]) { %>
            <form method="post" action="<%= url %>/mod"><%~ it.csrfInput() %><input type="hidden" name="action" value="<%= a %>"><button type="submit" role="menuitem"><%= l %></button></form>
            <% } %>
          <% } %>
        </div>
      </details>
      <% } %>
    </div>
  </article>

  <section class="comments" id="comments" aria-label="Comments">
    <% if (s.locked) { %><div class="banner banner-info" role="status"><strong>Comments are locked.</strong> New comments cannot be posted.</div><% } %>
    <% if (live && !s.locked) { %>
      <% if (it.user) { %>
      <form method="post" action="<%= url %>/comment" class="comment-form" id="comment-composer">
        <%~ it.csrfInput() %>
        <p class="muted small">Comment as <a href="/u/<%= it.user.username %>">u/<%= it.user.username %></a></p>
        <%~ include('_editor', { g: it, name: 'body', label: 'Comment', placeholder: 'What are your thoughts?', id: 'comment-body', rows: 4 }) %>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Comment</button></div>
      </form>
      <% } else { %>
      <div class="login-to-comment"><span>Log in or sign up to leave a comment</span><a class="btn btn-primary" href="/login?next=<%= encodeURIComponent(url) %>">Log In</a></div>
      <% } %>
    <% } %>
    <div class="comments-head">
      <form method="get" action="<%= it.tree.focus ? S.commentUrl(s, it.tree.focus.id) : url %>" class="inline">
        <label for="csort">Sort by:</label>
        <select id="csort" name="sort" data-autosubmit><% for (const [k, l] of Object.entries(S.COMMENT_SORTS)) { %><option value="<%= k %>"<%= it.sort === k ? ' selected' : '' %>><%= l %></option><% } %></select>
        <noscript><button type="submit">Sort</button></noscript>
      </form>
    </div>
    <% if (it.tree.focus) { %>
      <div class="banner banner-info">You are viewing a single comment's thread. <a href="<%= url %>#comments">View all comments</a><% if (it.tree.parent) { %> &middot; <a href="<%= S.commentUrl(s, it.tree.parent.id) %>">Show parent comment</a><% } %></div>
    <% } %>
    <% if (!it.tree.roots.length) { %><div class="empty-state"><p><strong>No comments yet.</strong></p><p>Be the first to share what you think!</p></div><% } %>
    <% if (it.cw) { %><%~ it.cw %><% } else { %><div class="comment-tree">
    <% for (const c of it.tree.roots) { %><%~ include('_comment', { g: it, c }) %><% } %>
    </div><% } %>
  </section>
  <% if (it.user && live && !s.locked && !it.edKind) { %>
  <template id="reply-template">
    <form method="post" action="<%= url %>/comment" class="comment-form reply-form">
      <%~ it.csrfInput() %><input type="hidden" name="parent_id" value="">
      <%~ include('_editor', { g: it, name: 'body', label: 'Reply', placeholder: 'Reply', id: 'reply-body', rows: 3 }) %>
      <div class="form-actions"><button type="button" class="btn btn-ghost" data-cancel-reply>Cancel</button><button type="submit" class="btn btn-primary">Reply</button></div>
    </form>
  </template>
  <% } %>
</div>
<aside class="cr-side" aria-label="Sidebar"><%~ include('_sidebar', { g: it, sb: it.sidebar }) %></aside>
</div>
