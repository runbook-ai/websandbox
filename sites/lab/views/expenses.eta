<% layout('layout') %>
<h1>My expense claims</h1>
<p><a class="button" href="/expenses/new">New claim</a></p>
<table class="grid"><thead><tr><th>Date</th><th>Category</th><th>Merchant</th><th>Description</th><th>Amount</th><th>Status</th></tr></thead><tbody>
<% for (const e of it.rows) { %><tr><td><%= e.spent_on %></td><td><%= e.category %></td><td><%= e.merchant %></td><td><%= e.description %></td><td><%= it.lab.money(e.amount_cents) %></td><td><%= e.status %></td></tr><% } %>
<% if (!it.rows.length) { %><tr><td colspan="6" class="muted">No claims yet.</td></tr><% } %>
</tbody></table>
