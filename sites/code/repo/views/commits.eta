<% layout('layout') %>
<% const p = it.project, enc = it.enc, base = '/' + p.full_path; %>
<div class="tree-controls">
  <%~ include('repo/_ref_switch', { refs: it.refs, ref: it.ref, pattern: base + '/-/commits/{ref}' + (it.path ? '/' + enc(it.path) : '') }) %>
  <%~ include('repo/_repo_crumb', { p, ref: it.ref, path: it.path }) %>
</div>
<h1 class="sr-only">Commits</h1>
<form method="get" action="<%= base %>/-/commits/<%= enc(it.ref) %><%= it.path ? '/' + enc(it.path) : '' %>" class="filter-bar" role="search" aria-label="Filter commits">
  <label class="sr-only" for="commits-author">Author</label>
  <input type="text" id="commits-author" name="author" value="<%= it.author %>" placeholder="Author" list="commit-authors" autocomplete="off">
  <datalist id="commit-authors"><% for (const a of it.authors) { %><option value="<%= a.author_name %>"><%= a.author_email %></option><% } %></datalist>
  <label class="sr-only" for="commits-search">Search by message</label>
  <input type="search" id="commits-search" name="search" value="<%= it.search %>" placeholder="Search by message">
  <button type="submit" class="btn">Filter</button>
  <% if (it.author || it.search) { %><a class="btn btn-link" href="<%= base %>/-/commits/<%= enc(it.ref) %><%= it.path ? '/' + enc(it.path) : '' %>">Clear filters</a><% } %>
  <span class="spacer" style="flex:1"></span>
  <% if (it.author) { %><span class="muted">Author: <strong><%= it.author %></strong></span><% } %>
</form>
<% if (it.empty) { %>
  <div class="empty-state"><h3>No commits found</h3><% if (it.author || it.search || it.path) { %><p>Try a different author, message or path.</p><% } %></div>
<% } else { %>
  <% if (it.vw) { %><%~ it.vw %><% } else { %><% for (const d of it.days) { %>
  <section class="commits-day" aria-label="Commits on <%= it.date(d.day + ' 00:00:00') %>">
    <h2><%= it.date(d.day + ' 00:00:00') %> <span class="day-count"><%= it.plural(d.commits.length, 'commit') %></span></h2>
    <ul class="commit-list">
      <% for (const c of d.commits) { %><%~ include('repo/_commit_row', { c, p, ref: it.ref, time: it.time, avatar: it.avatar, enc }) %><% } %>
    </ul>
  </section>
  <% } %><% } %>
  <%~ include('_pager', { pager: it.pager }) %>
  <% if (it.truncatedEnd) { %><div class="history-banner" role="note"><strong>History truncated.</strong> Older commits of this branch were not imported into this sandbox.</div><% } %>
<% } %>
