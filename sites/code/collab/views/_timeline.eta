<%/* include('collab/_timeline', {X: it, kind, target, timeline, noteBase, canComment, project}) */%>
<% const X = it.X, U = X.U, kind = it.kind, T = it.target, P = it.project, isMr = kind === 'merge_request';
   const md = (s) => X.md(s, { project: P, breaks: true }); %>
<ul id="notes-list" class="notes main-notes-list timeline">
<% for (const item of it.timeline) { %><%~ include('collab/_timeline_item', { ...it, item }) %><% } %>
</ul>
