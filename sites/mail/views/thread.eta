<% layout('layout') %>
<% const st = it.state; const last = it.msgs[it.msgs.length - 1]; %>
<form method="post" action="/threads/action" class="toolbar thread-toolbar" role="toolbar" aria-label="Conversation actions">
  <%~ it.csrfInput() %>
  <input type="hidden" name="ids" value="<%= it.t.id %>">
  <input type="hidden" name="return" value="<%= it.returnTo %>">
  <a href="<%= it.returnTo %>" class="back">&larr; Back</a>
  <% if (st.trash) { %>
    <button name="action" value="untrash">Restore</button>
  <% } else { %>
    <% if (st.inbox) { %><button name="action" value="archive">Archive</button><% } else { %><button name="action" value="inbox">Move to Inbox</button><% } %>
    <% if (st.spam) { %><button name="action" value="notspam">Not spam</button><% } else { %><button name="action" value="spam">Report spam</button><% } %>
    <button name="action" value="trash">Delete</button>
  <% } %>
  <button name="action" value="unread">Mark as unread</button>
  <button name="action" value="<%= st.important ? 'unimportant' : 'important' %>"><%= st.important ? 'Mark not important' : 'Mark important' %></button>
  <% if (it.labels.length) { %>
  <select name="action" aria-label="Label as" data-submit-on-change>
    <option value="">Label as&hellip;</option>
    <% for (const l of it.labels) { %><option value="<%= it.threadLabels.some((x) => x.id === l.id) ? 'unlabel' : 'label' %>:<%= l.id %>"><%= it.threadLabels.some((x) => x.id === l.id) ? 'Remove ' : '' %><%= l.name %></option><% } %>
  </select>
  <% } %>
</form>
<article class="conversation">
  <h1 class="conv-subject"><%= it.t.subject || '(no subject)' %>
    <% if (st.inbox) { %><span class="chip sys">Inbox</span><% } %>
    <% for (const l of it.threadLabels) { %><span class="chip" style="border-color:<%= l.color %>"><%= l.name %></span><% } %>
  </h1>
  <% if (it.older) { %><%~ it.older %>
  <% } else { %><% it.msgs.forEach((m, i) => { const open = i === it.msgs.length - 1 || it.unreadIds.includes(m.id) || m.is_draft; %><%~ include('_message', { ...it, m, open }) %>  <% }) %><% } %>
</article>
