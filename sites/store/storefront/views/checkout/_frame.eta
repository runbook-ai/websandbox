<%/* include('checkout/_frame', it): the checkout widget's frame (it.cf) + the hidden fields it fills */%><% const f = it.cf; %><iframe class="wsb-frame checkout-frame" data-wsb-frame="<%= f.name %>" data-origin="<%= f.origin %>" src="<%= f.src %>" title="<%= f.title %>" style="width:100%;min-height:120px;border:0"></iframe><% for (const [k, v] of f.fields) { %><input type="hidden" name="<%= k %>" value="<%= v %>" data-wsb-frame-field="<%= f.name %>"><% } %><script src="/_kit/widgets/frame.js" defer></script>