<% layout('admin/layout') %>
<% const U = it.U; const d = it.def; const p = it.p; const q = it.q; const E = it.errors; const isSales = d.filter === 'sales'; %>
<div class="message message-notice notice"><div>This report is generated from the live store data by a background job when you click <em>Show Report</em><% if (isSales) { %> (statistics tables: <a href="/admin/reports/report_statistics/">Refresh Statistics</a>)<% } %>.</div></div>
<% if (d.filter !== 'none') { %>
<form class="report-filter" method="get" action="<%= d.path %>" id="filter_form" aria-label="Filter" novalidate>
  <input type="hidden" name="filter" value="1">
  <fieldset class="admin__fieldset" style="margin:0"><legend>Filter</legend>
  <% if (isSales && !d.noDateUsed) { %>
  <div class="admin__field"><div class="admin__field-label"><label for="sales_report_report_type">Date Used</label></div><div class="admin__field-control"><select id="sales_report_report_type" name="report_type"><option value="created_at_order"<%= p.dateUsed === 'created_at' ? ' selected' : '' %>><%= (d.dateLabels || [])[0] || 'Order Created' %></option><option value="updated_at_order"<%= p.dateUsed === 'updated_at' ? ' selected' : '' %>><%= (d.dateLabels || [])[1] || 'Order Updated' %></option></select></div></div>
  <% } %>
  <div class="admin__field"><div class="admin__field-label"><label for="sales_report_period_type"><%= isSales ? 'Period' : 'Show By' %></label></div><div class="admin__field-control"><select id="sales_report_period_type" name="report_period"><% for (const [v, l] of [['day', 'Day'], ['month', 'Month'], ['year', 'Year']]) { %><option value="<%= v %>"<%= p.period === v ? ' selected' : '' %>><%= l %></option><% } %></select></div></div>
  <div class="admin__field _required<%= E.report_from ? ' _error' : '' %>"><div class="admin__field-label"><label for="sales_report_from">From</label></div><div class="admin__field-control"><input type="text" id="sales_report_from" name="report_from" value="<%= it.fromValue %>" placeholder="M/D/YY" autocomplete="off"><% if (E.report_from) { %><div class="admin__field-error" role="alert"><%= E.report_from %></div><% } %></div></div>
  <div class="admin__field _required<%= E.report_to ? ' _error' : '' %>"><div class="admin__field-label"><label for="sales_report_to">To</label></div><div class="admin__field-control"><input type="text" id="sales_report_to" name="report_to" value="<%= it.toValue %>" placeholder="M/D/YY" autocomplete="off"><% if (E.report_to) { %><div class="admin__field-error" role="alert"><%= E.report_to %></div><% } %></div></div>
  <% if (isSales) { %>
  <div class="admin__field"><div class="admin__field-label"><label for="sales_report_show_order_statuses">Order Status</label></div><div class="admin__field-control"><select id="sales_report_show_order_statuses" name="show_order_statuses"><option value="0"<%= p.statuses.length ? '' : ' selected' %>>Any</option><option value="1"<%= p.statuses.length ? ' selected' : '' %>>Specified</option></select></div></div>
  <div class="admin__field" data-show-when="show_order_statuses=1"><div class="admin__field-label"><label for="sales_report_order_statuses">Specified Order Status</label></div><div class="admin__field-control"><select id="sales_report_order_statuses" name="order_statuses" multiple size="6"><% for (const [v, l] of it.statuses) { %><option value="<%= v %>"<%= p.statuses.includes(v) ? ' selected' : '' %>><%= l %></option><% } %></select></div></div>
  <div class="admin__field"><div class="admin__field-label"><label for="sales_report_show_empty_rows">Empty Rows</label></div><div class="admin__field-control"><select id="sales_report_show_empty_rows" name="show_empty_rows"><option value="0"<%= p.showEmpty ? '' : ' selected' %>>No</option><option value="1"<%= p.showEmpty ? ' selected' : '' %>>Yes</option></select></div></div>
  <% } %>
  </fieldset>
  <div class="form-buttons"><button type="submit" class="action-primary" id="filter_form_submit"><%= isSales ? 'Show Report' : 'Refresh' %></button></div>
</form>
<% } %>
<% if (it.state === 'pending') { %>
<% if (it.jobPoll) { %>  <div class="message message-notice notice" id="wsb-job" data-poll="<%= it.jobPoll %>"><div><span class="wsb-spin" role="status">Generating the report (run #<%= it.run.id %>)&hellip;</span> This can take a minute; the page shows the report when it is ready. <a href="<%= it.req.url %>">Refresh now</a></div></div><%~ it.widgets.script('jobwait') %>
<% } else { %>  <div class="message message-notice notice" data-report-wait="700" role="status"><div>The report is being generated (run #<%= it.run.id %>). This page refreshes automatically&hellip; <a href="<%= it.req.url %>">Refresh now</a></div></div><% } %>
<% } else if (it.state === 'failed') { %>
  <div class="message message-error error" role="alert"><div>The report could not be generated: <%= it.error %>. <a href="<%= it.req.url %>">Try again</a></div></div>
<% } else if (it.state === 'done') { %>
  <div class="grid-toolbar"><div class="left"><div class="admin__control-support-text"><span data-records-found><%= it.run.row_count %></span> records found</div></div>
    <div class="right muted">Generated <%= U.date.datetime(it.run.finished_at) %></div></div>
  <div class="admin__data-grid-wrap"><table class="data-grid" id="gridReport">
    <thead><tr><% for (const c of d.columns) { %><th class="<%= c.type === 'money' || c.type === 'num' || c.type === 'pct' ? 'num' : '' %>" scope="col"><% if (it.sortHref) { %><a href="<%= it.sortHref(c.key) %>"><%= c.label %></a><% } else { %><%= c.label %><% } %></th><% } %></tr></thead>
    <tbody>
    <% if (!it.rows.length) { %><tr class="data-grid-tr-no-data"><td colspan="<%= d.columns.length %>">We couldn't find any records.</td></tr><% } %>
    <% for (const row of it.rows) { %><tr><% for (const c of d.columns) { %><td class="<%= c.type === 'money' || c.type === 'num' || c.type === 'pct' ? 'num' : '' %>"><% if (c.key === 'product_name' || (c.key === 'name' && row.product_id)) { %><a href="/admin/catalog/product/edit/id/<%= row.product_id %>/"><%~ it.cell(c, row[c.key], p.period) %></a><% } else if (c.key === 'name' && row.customer_id) { %><a href="/admin/customer/index/edit/id/<%= row.customer_id %>/"><%~ it.cell(c, row[c.key], p.period) %></a><% } else { %><%~ it.cell(c, row[c.key], p.period) %><% } %></td><% } %></tr><% } %>
    </tbody>
    <% if (it.rows.length && !d.paged && d.columns.some((c) => c.type === 'money' || c.type === 'num')) { %><tfoot><tr class="totals"><% d.columns.forEach((c, i) => { %><td class="<%= c.type === 'money' || c.type === 'num' ? 'num' : '' %>"><%~ i === 0 ? 'Total' : (c.type === 'money' || c.type === 'num') && !['product_price', 'orders_avg_amount', 'product_id', 'percent'].includes(c.key) ? it.cell(c, it.totals[c.key]) : '' %></td><% }) %></tr></tfoot><% } %>
  </table></div>
  <% if (it.pager) { %><%~ include('kit/pagination', { p: it.pager }) %><% } %>
<% } %>
