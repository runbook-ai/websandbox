<%/* include('_composer', {g, replyTo, placeholder, text}) the inline composer */%>
<% const g = it.g; const me = g.me; %>
<form method="post" action="/compose" class="composer composer-inline" data-composer><%~ g.csrfInput() %>
  <% if (it.replyTo) { %><input type="hidden" name="reply_to" value="<%= it.replyTo.id %>"><% } %>
  <div class="composer-row"><span class="av av-md" style="background:<%= me ? me.avatar_color : '#868e96' %>" aria-hidden="true"><%= g.initials(me ? me.display_name : g.user.username) %></span>
    <div class="composer-body">
      <% if (it.replyTo) { %><p class="muted small composer-replying">Replying to <a href="/<%= it.replyTo.handle %>">@<%= it.replyTo.handle %></a></p><% } %>
      <label class="sr-only" for="<%= it.replyTo ? 'reply-text' : 'home-text' %>"><%= it.replyTo ? 'Post your reply' : 'Post text' %></label>
      <textarea id="<%= it.replyTo ? 'reply-text' : 'home-text' %>" name="text" rows="2" maxlength="2000" placeholder="<%= it.placeholder || 'What’s happening?' %>" data-count-chars><%= it.text || '' %></textarea>
    </div></div>
  <div class="composer-foot"><span class="char-ring" data-ring aria-live="polite"></span><button type="submit" class="btn btn-primary" data-submit><%= it.replyTo ? 'Reply' : 'Post' %></button></div>
</form>
