<% layout('layout') %>
<% const a = it.a; const D = it.D; const au = it.author; %>
<div class="art-grid">
  <aside class="rail" aria-label="Reactions">
    <div class="rail-in">
      <% for (const x of D.REACTIONS) { const on = it.mineR.has(x.kind); %>
      <form method="post" action="/reactions" class="react-form" data-react="<%= x.kind %>"><%~ it.csrfInput() %>
        <input type="hidden" name="target" value="article"><input type="hidden" name="id" value="<%= a.id %>"><input type="hidden" name="kind" value="<%= x.kind %>"><input type="hidden" name="on" value="<%= on ? 0 : 1 %>">
        <button type="submit" class="rail-btn rail-<%= x.kind %><%= on ? ' on' : '' %>" aria-pressed="<%= on %>" aria-label="<%= x.label %> (<%= it.counts[x.kind] || 0 %>)" title="<%= x.label %>"><span class="rail-ico" aria-hidden="true"><%= x.icon %></span><span class="rail-n" data-count><%= it.counts[x.kind] || 0 %></span></button>
      </form>
      <% } %>
      <a class="rail-btn" href="#comments" aria-label="Jump to comments (<%= it.tree.count %>)" title="Comments"><span class="rail-ico" aria-hidden="true">&#128172;</span><span class="rail-n"><%= it.tree.count %></span></a>
      <form method="post" action="/readinglist" class="save-form" data-save="<%= a.id %>"><%~ it.csrfInput() %><input type="hidden" name="id" value="<%= a.id %>"><input type="hidden" name="on" value="<%= it.saved ? 0 : 1 %>">
        <button type="submit" class="rail-btn rail-save<%= it.saved ? ' on' : '' %>" aria-pressed="<%= it.saved %>" aria-label="<%= it.saved ? 'Remove from reading list' : 'Save to reading list' %> (<%= it.saves %>)" title="Save"><span class="rail-ico" aria-hidden="true">&#9733;</span><span class="rail-n" data-count><%= it.saves %></span></button></form>
    </div>
  </aside>
  <article class="art box" aria-labelledby="art-title">
    <% if (a.status !== 'published') { %><div class="banner banner-warn" role="status">This is an unpublished draft. Only you can see it. <a href="<%= a.url %>/edit">Continue editing</a></div><% } %>
    <header class="art-head">
      <div class="art-author">
        <a href="/<%= a.handle %>"><span class="av av-md" style="background:<%= a.avatar_color %>" aria-hidden="true"><%= it.initials(a.display_name) %></span></a>
        <div><a class="art-author-name" href="/<%= a.handle %>"><%= a.display_name %></a>
          <div class="muted small">Posted on <%~ it.when(a.published_at || a.created_at, 'date') %><% if (a.edited_at) { %> &bull; Edited on <%~ it.when(a.edited_at, 'date') %><% } %> &bull; <%= a.reading_time || 1 %> min read</div></div>
        <% if (it.mine) { %><div class="art-own"><a class="btn btn-sm btn-ghost" href="<%= a.url %>/edit">Edit</a>
          <form method="post" action="<%= a.url %>/delete" class="inline" data-confirm="Delete this post? This can't be undone."><%~ it.csrfInput() %><button class="btn btn-sm btn-ghost btn-danger" type="submit">Delete</button></form></div><% } %>
      </div>
      <% if (it.total) { %><p class="art-reacts small muted" aria-label="Reactions"><% for (const x of D.REACTIONS) { if (!it.counts[x.kind]) continue; %><span class="art-react"><span aria-hidden="true"><%= x.icon %></span> <%= it.counts[x.kind] %> <%= x.label.toLowerCase() %></span><% } %></p><% } %>
      <h1 id="art-title" class="art-title"><%= a.title %></h1>
      <% if (it.tags.length) { %><div class="tags"><% for (const t of it.tags) { %><a class="tag" href="/t/<%= t %>" style="--tag:<%= D.tagColor(t) %>"><span aria-hidden="true">#</span><%= t %></a><% } %></div><% } %>
    </header>
    <% if (it.series && it.series.s) { const idx = it.series.parts.findIndex((x) => x.id === a.id); %>
    <nav class="series-box" aria-label="Series">
      <p class="series-name"><a href="/<%= a.handle %>/series/<%= it.series.s.id %>"><%= it.series.s.title %></a> <span class="muted small">(<%= it.series.parts.length %> part series)</span></p>
      <ol class="series-parts"><% it.series.parts.forEach((x, i) => { %><li class="<%= x.id === a.id ? 'on' : '' %>"><a href="<%= D.articleUrl(x) %>"<%~ x.id === a.id ? ' aria-current="page"' : '' %>><span class="series-n"><%= i + 1 %></span><%= x.title %></a></li><% }) %></ol>
    </nav>
    <% } %>
    <div class="prose"><%~ it.md(a.body) %></div>
  </article>
  <aside class="art-side" aria-label="About the author">
    <section class="box author-card" style="--brand:<%= a.avatar_color %>">
      <div class="author-band" aria-hidden="true"></div>
      <a class="author-top" href="/<%= a.handle %>"><span class="av av-md" style="background:<%= a.avatar_color %>" aria-hidden="true"><%= it.initials(a.display_name) %></span><strong><%= a.display_name %></strong></a>
      <% if (!it.mine) { %><form method="post" action="/follow" class="follow-form" data-follow-user="<%= a.handle %>"><%~ it.csrfInput() %><input type="hidden" name="handle" value="<%= a.handle %>"><input type="hidden" name="on" value="<%= it.following ? 0 : 1 %>">
        <button type="submit" class="btn btn-block <%= it.following ? 'btn-outline' : 'btn-primary' %>" aria-pressed="<%= it.following %>"><%= it.following ? 'Following' : 'Follow' %></button></form><% } %>
      <% if (au.account_bio) { %><p class="small"><%= au.account_bio %></p><% } %>
      <dl class="author-facts small"><dt>Joined</dt><dd><%= it.dateLong(au.joined_at) %></dd><dt>Followers</dt><dd><%= it.authorStats.followers %></dd></dl>
    </section>
    <% if (it.more.length) { %>
    <section class="box">
      <h2 class="box-head">More from <a href="/<%= a.handle %>"><%= a.display_name %></a></h2>
      <ul class="more-list"><% for (const m of it.more) { %><li><a href="<%= m.url %>"><%= m.title %></a><div class="tags tags-sm"><% for (const t of m.tags) { %><span class="muted small">#<%= t %></span><% } %></div></li><% } %></ul>
    </section>
    <% } %>
  </aside>
</div>
<section class="comments box" id="comments" aria-labelledby="comments-title">
  <div class="comments-head">
    <h2 id="comments-title">Top comments (<%= it.tree.count %>)</h2>
    <form method="get" action="<%= a.url %>#comments" class="inline"><label class="sr-only" for="csort">Sort comments</label>
      <select id="csort" name="sort" data-autosubmit><% for (const [k, l] of [['top', 'Top'], ['latest', 'Latest'], ['oldest', 'Oldest']]) { %><option value="<%= k %>"<%= it.sort === k ? ' selected' : '' %>><%= l %></option><% } %></select><noscript><button type="submit">Sort</button></noscript></form>
  </div>
  <% if (it.user) { %>
  <form method="post" action="<%= a.url %>/comments" class="comment-form" id="comment-form" data-comment-form><%~ it.csrfInput() %>
    <span class="av av-sm" style="background:<%= it.me ? it.me.avatar_color : '#868e96' %>" aria-hidden="true"><%= it.initials(it.me ? it.me.display_name : it.user.username) %></span>
    <div class="comment-form-main"><label class="sr-only" for="new-comment">Add to the discussion</label><textarea id="new-comment" name="body" rows="3" placeholder="Add to the discussion" required></textarea>
      <div class="comment-form-foot"><span class="muted small">Markdown is supported.</span><button type="submit" class="btn btn-primary btn-sm">Submit</button></div></div>
  </form>
  <% } else { %><p class="box-pad muted"><a href="/login?next=<%= encodeURIComponent(a.url + '#comments') %>">Log in</a> to join the discussion.</p><% } %>
  <div class="comment-list">
    <% for (const c of it.tree.roots) { %><%~ include('_comment', { g: it, c, a }) %><% } %>
  </div>
</section>
